{
  "name": "tlv-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:load": "node scripts/quest-load-test.mjs",
    "test:rls-remote": "node scripts/verify-supabase-public-access.mjs",
    "verify:sentry-production": "node scripts/verify-sentry-production.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "10.69.0",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "twilio": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "@sentry/nextjs": {
      "brace-expansion": "5.0.9"
    },
    "fast-uri": "3.1.5"
  }
}
