# Public runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_TWILIO_SANDBOX_NUMBER=14155238886
NEXT_PUBLIC_TWILIO_SANDBOX_JOIN_CODE=replace_me

# Server-only Supabase key (Settings > API Keys > Secret key)
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Temporary PII encryption. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace_with_32_byte_base64_key
TOKEN_PEPPER=replace_with_random_secret

# Internal API authentication
ADMIN_API_SECRET=replace_with_random_secret
WORKER_SECRET=replace_with_random_secret

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURES=true
# Public Beta. Enabling this also marks inbound WhatsApp messages as read.
TWILIO_WHATSAPP_TYPING_INDICATORS=false

# Providers
RESEND_API_KEY=re_replace_me
EMAIL_FROM=TLV Quest <quest@example.com>
GEMINI_API_KEY=replace_me
GEMINI_VISION_MODEL=gemini-2.5-flash

# Admin and environment controls
ADMIN_EMAILS=admin@example.com
ENABLE_EXTERNAL_MESSAGES=false
TEST_PHONE_ALLOWLIST=

# Observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional overrides; Vercel supplies release and environment automatically.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
